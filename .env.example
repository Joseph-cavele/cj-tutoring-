MONGODB_URI=your_mongodb_connection_string

# Server-only. sk_test_... while testing, sk_live_... for real money - the
# prefix is the only thing that tells you which, so check it before going live.
PAYSTACK_SECRET_KEY=your_paystack_secret_key
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=your_paystack_public_key
#
# There is deliberately NO callback or webhook URL variable here.
#
#   Callback: the app sends its own callback_url with every transaction
#             (/checkout/complete), which overrides whatever the dashboard
#             says. Setting one here would do nothing.
#
#   Webhook:  configured in the Paystack dashboard, not in this file. It must
#             point at exactly:
#
#                 https://<your-domain>/api/webhooks/paystack
#
#             Note the order: webhooks/paystack, NOT paystack/webhook. The
#             webhook is the only thing that settles a payment when the
#             customer closes the browser after paying, so a wrong path here
#             means money taken and lessons left unconfirmed. Run
#             `npm run check:services` to have the correct URL printed.

PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret

# Resend - transactional email (CLAUDE.md section 23).
# FROM_EMAIL must be on a domain verified in the Resend dashboard, or
# Resend refuses the send. Accepts "Name <you@domain.com>" too.
RESEND_API_KEY=your_resend_api_key
FROM_EMAIL=support@your-verified-domain.co.za

# NextAuth v5 reads AUTH_SECRET; NEXTAUTH_SECRET is from v4 and is ignored.
AUTH_SECRET=your_auth_secret

# Leave AUTH_URL unset in development. Pinning the origin to localhost makes
# NextAuth hand that URL back to a phone testing over the LAN, which then
# points at the handset itself. trustHost derives it from the request instead.
# In production set AUTH_URL to the real site origin and drop AUTH_TRUST_HOST.
AUTH_TRUST_HOST=true

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset

# Gemini (Google AI) - AI Study Assistant, CLAUDE.md section 17
AI_API_KEY=your_gemini_api_key
AI_MODEL=gemini-3.6-flash

# Zoom Server-to-Server OAuth - online lessons.
# Server-only: never expose these to the browser. When unset, bookings are
# still accepted and confirmed, they simply carry no meeting link.
ZOOM_ACCOUNT_ID=your_zoom_account_id
# Secret Token from the Zoom app's Feature tab. Verifies webhook calls and
# answers the Marketplace URL-validation challenge at /api/webhooks/zoom.
ZOOM_WEBHOOK_SECRET_TOKEN=your_zoom_webhook_secret_token
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret
