# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
*.bak

# The template IS committed: it lists which variables the app needs, with
# placeholder values only. Never put a real credential in it - this negation
# means anything written here goes to the repo.
!.env.example
.env.local
.env.local.example
.env.local.bak


# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
