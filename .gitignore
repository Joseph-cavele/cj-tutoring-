# Dependencies
node_modules/

# Next.js build output
.next/
out/
build/

# Environment files - NEVER commit these, they hold live credentials
.env
.env.*
.env.local
.env.local.bak
*.bak
# The example file is the one exception: it holds placeholder names only, so
# a new developer knows which variables to set.
!.env.example

# Logs and debug output
*.log
npm-debug.log*

# OS and editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/

# TypeScript incremental build info
*.tsbuildinfo
